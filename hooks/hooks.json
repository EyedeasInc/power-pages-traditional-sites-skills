{
  "description": "powerpages-traditional-site: after a content skill, remind about cache flush and table permissions",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill|skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill_reminder.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/skill_reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
